{
  "manifest_version": 3,
  "name": "关注计数器 – 防撞限、查回关",
  "short_name": "关注计数器",
  "version": "0.8.3",
  "description": "适用于 X（原 Twitter）：记录关注进度、提醒休息并追踪回关；可选自动滚动列表，不自动关注或取关。数据保存在本机。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "action": {
    "default_title": "关注计数器 – 防撞限、查回关",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "limits.js",
        "stats.js",
        "sound.js",
        "ui.js",
        "content.js",
        "following.js"
      ],
      "run_at": "document_start"
    }
  ]
}
